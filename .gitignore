# Nix build outputs
result
result-*

# Machine-specific hardware config: hosts/chromebook keeps the delbin-generated
# file and hosts/vaio keeps a placeholder template (regenerate before switch;
# see README.md). Uncomment if you prefer never committing generated files:
# hosts/chromebook/hardware-configuration.nix
# hosts/vaio/hardware-configuration.nix

# Agent knowledge graph (local / optional)
graphify-out/

# Python bytecode from scripts/*.py
__pycache__/
*.py[cod]

# Guard against accidentally staging plaintext agenix keys or decrypted secrets.
# Encrypted ciphertext files (`secrets/*.age`) and `secrets/master-pubkey.txt` ARE tracked.
secrets/*.key
secrets/*.plain
secrets/*.tmp
secrets/*~
